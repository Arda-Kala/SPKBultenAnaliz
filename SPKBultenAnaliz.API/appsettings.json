{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/spk-bulten-analiz-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({MachineName}/PID:{ProcessId}) {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.5-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/models",
    "TimeoutSaniye": 180,
    "MaksimumYenidenDeneme": 3
  },
  "Jwt": {
    "Key": "",
    "Issuer": "SPKBultenAnalizPlatformu",
    "Audience": "SPKBultenAnalizKullanicilari",
    "SureDakika": 120
  },
  "AllowedHosts": "*"
}